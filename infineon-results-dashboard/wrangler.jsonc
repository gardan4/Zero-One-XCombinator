{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infineon-fab-copilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODEL_BASE_URL": "https://api.featherless.ai/v1",
    "MODEL_NAME": "Qwen/Qwen3.6-27B"
  }
}
