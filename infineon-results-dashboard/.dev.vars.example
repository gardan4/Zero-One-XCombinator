# Local-only Worker secrets. Copy to `.dev.vars` if you want model reranking locally.
# Leave unset to use the built-in retrieval baseline.

# Featherless example:
# MODEL_BASE_URL=https://api.featherless.ai/v1
# MODEL_NAME=Qwen/Qwen3.6-27B
# MODEL_API_KEY=...

# DeepSeek example:
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
# MODEL_API_KEY=...
