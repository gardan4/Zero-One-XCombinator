# Copy to .env and fill in. Loaded by the backend and (where noted) the CLIs.
# .env is gitignored; THIS file is committed — keep real secrets OUT of it (placeholders only).

# --- backend / control plane -------------------------------------------------
ZO_API_HOST=0.0.0.0
ZO_API_PORT=8000
ZO_CORS_ORIGINS=*
# POST /api/launch spawns `uv run` subprocesses — OFF unless set. Enable on localhost/trusted
# machines ONLY; with ZO_API_HOST=0.0.0.0 an open launch endpoint is remote code execution.
ZO_ALLOW_LAUNCH=
# Shared run store read by the backend AND written by the train/eval/agent CLIs.
# Leave blank to default to <repo>/experiments. Point at shared scratch on the cluster.
ZO_EXPERIMENTS_DIR=

# --- frontend ----------------------------------------------------------------
# Baked into the JS bundle at build time; browser calls go here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- experiment tracking (optional) ------------------------------------------
# Leave WANDB_API_KEY blank to fall back to local-only metrics.jsonl logging.
# A W&B run lands at <entity>/<project>. Team workspace = XCombinator/XCombinator.
WANDB_API_KEY=
WANDB_ENTITY=XCombinator
WANDB_PROJECT=XCombinator
# On Leonardo compute nodes (no internet) use WANDB_MODE=offline, then `wandb sync` from a login node.
WANDB_MODE=online

# --- huggingface (datasets + gated models) -----------------------------------
HF_TOKEN=
# Point HF caches at fast/large cluster scratch so $HOME doesn't fill up.
HF_HOME=

# --- Featherless serverless inference (eval without self-hosting vLLM) --------
# Get a key at https://featherless.ai/account/api-keys (or route via HF — see FEATHERLESS_ROUTE).
FEATHERLESS_API_KEY=
# direct = https://api.featherless.ai/v1  |  hf-router = https://router.huggingface.co/featherless-ai
FEATHERLESS_ROUTE=direct
# Optional overrides (defaults above):
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_HF_ROUTER_URL=https://router.huggingface.co/featherless-ai

# --- model serving (used by eval + agent harness) ----------------------------
# An OpenAI-compatible endpoint, e.g. a vLLM server hosting your fine-tuned model.
ZO_MODEL_BASE_URL=http://localhost:8001/v1
ZO_MODEL_API_KEY=EMPTY

# --- Leonardo / SLURM cluster (training job submission over SSH) --------------
# Login is plain SSH, no 2FA at the hackathon. Login nodes (any of them):
#   login01-ext / login02-ext / login05-ext / login07-ext . leonardo.cineca.it
#   ssh <username>@login01-ext.leonardo.cineca.it
ZO_CLUSTER_HOST=login01-ext.leonardo.cineca.it
ZO_CLUSTER_USER=                      # your emailed Leonardo username (secret)
# `ssh`/`scp` do NOT read a password from env. For passwordless `zo-cluster submit`, run once:
#   ssh-copy-id <username>@login01-ext.leonardo.cineca.it      (then key auth works)
ZO_CLUSTER_PASSWORD=                  # SSH password (secret) — prefer an SSH key instead
ZO_CLUSTER_REPO_DIR=$HOME/Zero-One-Philyr
# Big files live on scratch (40-day retention); $HOME is only 50 GB.
ZO_CLUSTER_EXPERIMENTS_DIR=$SCRATCH/zo-experiments
ZO_SLURM_ACCOUNT=                     # may be unneeded — hackathon uses the reservation below
ZO_SLURM_PARTITION=boost_usr_prod
# Hackathon reservation. NOTE: not yet threaded through submit.py/_render or the sbatch template —
# see the "How this maps to our scaffold" gap in .claude/knowledge/cluster.md.
ZO_SLURM_RESERVATION=s_tra_ncc
ZO_SLURM_QOS=
# Reservation covers up to 4 nodes for our team. Start at 1; scale out only after a run proves out.
ZO_SLURM_NODES=1
# Leonardo node: 4 GPUs (A100, 64GB VRAM each), up to 512GB RAM, 32 CPUs. submit.py auto-derives
# mem=120GB×gpus and cpus=8×gpus from the value below; override with ZO_SLURM_MEM / ZO_SLURM_CPUS.
ZO_SLURM_GPUS_PER_NODE=1
ZO_SLURM_CPUS=8
ZO_SLURM_TIME=02:00:00

# --- Leonardo proxy (compute nodes have NO internet; password from onboarding deck p.95) -----
# Only for low-bandwidth traffic from compute nodes; download big files from a login node.
ZO_CLUSTER_PROXY=http://proxyuser:<PROXY_PASSWORD>@10.99.0.1:38425

# --- Judge / repro inference (Leonardo login node) -------------------------------------------
# Set ZO_CLUSTER_ON_LOGIN=1 when you are already SSH'd into Leonardo (skips remote ssh/scp).
ZO_CLUSTER_ON_LOGIN=
# Fine-tuned checkpoint: HF repo id OR a local path on shared storage ($SCRATCH).
ZO_INFER_MODEL=XCombinator/sft-fab-all
# After `just judge-stage`, set this to the downloaded directory (printed by stage-model):
ZO_INFER_MODEL_PATH=$SCRATCH/zo-models/XCombinator--sft-fab-all
ZO_MODEL_CACHE_DIR=$SCRATCH/zo-models
# Local eval inputs dir (created by `just judge-setup`):
ZO_JUDGE_EVAL_DIR=extras/eval_local
# Shorter wall times for inference / demo serve jobs:
ZO_SLURM_INFER_TIME=00:30:00
ZO_SLURM_SERVE_TIME=04:00:00
